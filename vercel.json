{
  "rewrites": [
    { "source": "/admin",           "destination": "/index.html" },
    { "source": "/admin/(.*)",      "destination": "/index.html" },
    { "source": "/danke",           "destination": "/index.html" },
    { "source": "/ratgeber",        "destination": "/index.html" },
    { "source": "/ratgeber/(.*)",   "destination": "/index.html" },
    { "source": "/ueber-uns",       "destination": "/index.html" },
    { "source": "/pruefen/wohnung", "destination": "/index.html" },
    { "source": "/pruefen/posten",  "destination": "/index.html" },
    { "source": "/pruefen/ergebnis","destination": "/index.html" },
    { "source": "/pruefen/absender","destination": "/index.html" },
    { "source": "/pruefen/download","destination": "/index.html" },
    { "source": "/pruefen/konto",   "destination": "/index.html" },
    { "source": "/login",           "destination": "/index.html" },
    { "source": "/impressum",       "destination": "/index.html" },
    { "source": "/agb",             "destination": "/index.html" },
    { "source": "/datenschutz",     "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options",        "value": "DENY" },
        { "key": "Referrer-Policy",        "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/admin",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    }
  ],
  "functions": {
    "api/admin-auth.js":  { "maxDuration": 5  },
    "api/analyse-foto.js": { "maxDuration": 60 }
  }
}
