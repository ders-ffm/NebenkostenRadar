{
  "name": "nebenkostenradar",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "probedruck": "esbuild scripts/pdf-probedruck.mjs --bundle --platform=node --format=esm --outfile=.probedruck.mjs --loader:.jsx=jsx --packages=external --log-level=error && node .probedruck.mjs; rm -f .probedruck.mjs",
    "dev": "vite",
    "build": "vite build && node scripts/prerender.mjs",
    "preview": "vite preview",
    "check": "npm run build && node scripts/seo-check.mjs && node scripts/pdf-konsistenz-test.mjs && node scripts/eingaben-test.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "^5.0.0",
    "@react-pdf/renderer": "^4.0.0",
    "@supabase/supabase-js": "^2.45.0",
    "node-fetch": "^3.3.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "esbuild": "^0.28.2",
    "pdfjs-dist": "^6.3.289",
    "vite": "^5.4.2"
  }
}
